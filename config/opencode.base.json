{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "external_directory": "deny"
  },
  "provider": {
    "local/ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local, via host.docker.internal)",
      "options": {
        "baseURL": "{env:OPENCODE_OLLAMA_BASE_URL}",
        "apiKey": "ollama"
      }
    }
  }
}
